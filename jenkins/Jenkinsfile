pipeline {
    agent any
    environment {
        REGISTRY = "docker.io/yourorg"
        IMAGE = "account-service"
        VERSION = "v${env.BUILD_NUMBER}"
    }
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Build Docker Image') { steps { sh "docker build -t $REGISTRY/$IMAGE:$VERSION ." } }
        stage('Push Image') { steps { sh "docker push $REGISTRY/$IMAGE:$VERSION" } }
        stage('Deploy to Kubernetes') { steps { sh "kubectl set image deployment/account-service account-service=$REGISTRY/$IMAGE:$VERSION" } }
    }
    post {
        failure {
            stage('Rollback') { steps { sh "kubectl rollout undo deployment account-service" } }
        }
    }
}
